  "requested_url": "https://replit.com/integrations",
  "final_url": "https://replit.com/integrations",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1\" />\n    <link rel=\"icon\" type=\"image/png\" href=\"https://integrations-hub.replit.app/api/static/favicon.png\" />\n    <link rel=\"canonical\" href=\"https://replit.com/integrations\" />\n    <link rel=\"preconnect\" href=\"https://cdn.replit.com\" crossorigin />\n    <link rel=\"dns-prefetch\" href=\"https://cdn.replit.com\" />\n\n    <title>Replit Integrations — Browse 450+ Connectors | Replit</title>\n    <meta name=\"description\" content=\"Browse 450+ Replit integrations and connectors — Stripe, Slack, Notion, Google Workspace, and more. Connect your tools and let Replit Agent build your app.\" />\n\n    <meta property=\"og:title\" content=\"Connect Tools. Ship Products. — 450+ Replit Integrations\" />\n    <meta property=\"og:description\" content=\"The largest integration library in AI. Find the connector you need and tell Replit Agent what to build — auth, wiring, and UI handled for you.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://replit.com/integrations\" />\n    <meta property=\"og:site_name\" content=\"Replit\" />\n    <meta property=\"og:image\" content=\"https://integrations-hub.replit.app/api/static/social-preview.png\" />\n    <meta property=\"og:image:width\" content=\"1200\" />\n    <meta property=\"og:image:height\" content=\"630\" />\n    <meta property=\"og:image:alt\" content=\"Replit Integrations — Connect tools. Ship products.\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:site\" content=\"@Replit\" />\n    <meta name=\"twitter:title\" content=\"Connect Tools. Ship Products. — 450+ Replit Integrations\" />\n    <meta name=\"twitter:description\" content=\"The largest integration library in AI. Find the connector you need and tell Replit Agent what to build.\" />\n    <meta name=\"twitter:image\" content=\"https://integrations-hub.replit.app/api/static/social-preview.png\" />\n\n    <script type=\"application/ld+json\" id=\"ld-structured\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"Organization\",\n          \"@id\": \"https://replit.com/#organization\",\n          \"name\": \"Replit\",\n          \"url\": \"https://replit.com/\",\n          \"logo\": \"https://integrations-hub.replit.app/api/static/favicon.png\",\n          \"sameAs\": [\n            \"https://x.com/replit\",\n            \"https://www.linkedin.com/company/repl-it\",\n            \"https://github.com/replit\",\n            \"https://en.wikipedia.org/wiki/Replit\",\n            \"https://www.crunchbase.com/organization/replit\"\n          ]\n        },\n        {\n          \"@type\": \"WebSite\",\n          \"@id\": \"https://replit.com/#website\",\n          \"url\": \"https://replit.com/\",\n          \"name\": \"Replit\",\n          \"publisher\": { \"@id\": \"https://replit.com/#organization\" }\n        },\n        {\n          \"@type\": \"SoftwareApplication\",\n          \"@id\": \"https://replit.com/#software\",\n          \"name\": \"Replit\",\n          \"description\": \"Replit is an AI-powered platform for building and deploying full-stack applications from natural language, with 450+ integrations and connectors.\",\n          \"applicationCategory\": \"DeveloperApplication\",\n          \"operatingSystem\": \"Web\",\n          \"url\": \"https://replit.com/\",\n          \"creator\": { \"@id\": \"https://replit.com/#organization\" }\n        },\n        {\n          \"@type\": \"WebPage\",\n          \"@id\": \"https://replit.com/integrations#webpage\",\n          \"url\": \"https://replit.com/integrations\",\n          \"name\": \"Replit Integrations — Browse 450+ Connectors | Replit\",\n          \"description\": \"Browse 450+ Replit integrations and connectors — Stripe, Slack, Notion, Google Workspace, and more. Connect your tools and let Replit Agent build your app.\",\n          \"datePublished\": \"2026-05-08T16:30:14Z\",\n          \"dateModified\": \"2026-07-27T04:33:54.000Z\",\n          \"isPartOf\": { \"@id\": \"https://replit.com/#website\" },\n          \"about\": { \"@id\": \"https://replit.com/#software\" },\n          \"provider\": { \"@id\": \"https://replit.com/#organization\" },\n          \"primaryImageOfPage\": \"https://integrations-hub.replit.app/api/static/social-preview.png\",\n          \"potentialAction\": [\n            {\n              \"@type\": \"SearchAction\",\n              \"target\": {\n                \"@type\": \"EntryPoint\",\n                \"urlTemplate\": \"https://replit.com/integrations?q={search_term_string}\"\n              },\n              \"query-input\": \"required name=search_term_string\"\n            },\n            {\n              \"@type\": \"RegisterAction\",\n              \"target\": {\n                \"@type\": \"EntryPoint\",\n                \"urlTemplate\": \"https://replit.com/?authModal=signup\"\n              }\n            }\n          ]\n        },\n        {\n          \"@type\": \"FAQPage\",\n          \"@id\": \"https://replit.com/integrations#faq\",\n          \"mainEntity\": [\n            {\n              \"@type\": \"Question\",\n              \"name\": \"How do connectors work in Replit?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Connectors give the Replit Agent authenticated access to your external tools — so it can read and write data, not just generate code that talks to APIs in the abstract. Under the hood, connectors handle the OAuth or API-key flow and store credentials securely; once you connect a service, the Agent can use it live while building. The same connection also powers your deployed app: when your users log in through Stripe, pull their bank data via Plaid, or trigger a Slack message, they're going through the same connector infrastructure. Connectors are also exposed as MCP tools, meaning the Agent can discover and call them autonomously mid-session without you writing the integration code yourself.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Which connectors are available?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Replit supports 450+ connectors, including Stripe, Slack, Plaid, Figma, Notion, Google Workspace, Microsoft 365, Airtable, Shopify, Salesforce, Atlassian (Jira), Razorpay, and many more. New connectors ship regularly. You can browse the full list at replit.com/integrations.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"How do I add a connector to my project?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Open the Integrations pane inside your Replit project and find the service you want to connect. For team-managed connectors (like Plaid or Stripe), an admin configures credentials once and individual users authenticate their own accounts. For personal connectors, you authenticate directly. Once connected, the Replit Agent automatically has access to those tools for the duration of your session — you don't need to wire anything up manually.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Can I connect a tool that isn't listed?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Yes. Replit supports the MCP (Model Context Protocol) standard, so any service that exposes an MCP server can be added directly. Go to replit.com/integrations, add a custom MCP endpoint, and the Agent will be able to discover and call its tools just like any first-party connector. Enterprise teams also use this path to connect internal systems and proprietary APIs.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Do connectors use my Replit credits?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Connecting to your tools is free — no credits are consumed by authentication or data reads. Credits are only used when the Agent generates or modifies code. One exception worth knowing: with the Stripe connector, you can actually earn Replit credits when you monetize your app. Builders receive $50 in credits for every $250 earned through Stripe, scaling up to $2,000 in credits for $100,000 in earnings. Credit rewards for additional payment connectors are coming soon.\"\n              }\n            }\n          ]\n        }\n      ]\n    }\n    </script>\n\n    <link rel=\"preload\" href=\"https://integrations-hub.replit.app/api/static/replit_brand_kit/fonts/diatype-variable.woff2\"\n          as=\"font\" type=\"font/woff2\" crossorigin />\n\n    <style>\n      @font-face {\n        font-family: 'Diatype';\n        src: url('https://integrations-hub.replit.app/api/static/replit_brand_kit/fonts/diatype-variable.woff2') format('woff2'),\n             url('https://integrations-hub.replit.app/api/static/replit_brand_kit/fonts/diatype-variable.ttf') format('truetype');\n        font-weight: 100 900;\n        font-display: block;\n      }\n      html { background-color: #FAF6F1; opacity: 0; }\n      html.fonts-ready { opacity: 1; transition: opacity 0.1s ease; }\n    </style>\n\n    <script>\n      (function() {\n        if (document.fonts && document.fonts.load) {\n          document.fonts.load('400 1em Diatype').then(function() {\n            document.documentElement.classList.add('fonts-ready');\n          }).catch(function() {\n            document.documentElement.classList.add('fonts-ready')